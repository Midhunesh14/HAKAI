HAKAI START

// Object-Oriented Programming
class Student {
    function init(name, age) {
        self.name = name
        self.age = age
    }

    function display() {
        print("Student Name: " + self.name)
        print("Student Age: " + str(self.age))
    }
}

class GraduateStudent extends Student {
    function init(name, age, thesis) {
        self.name = name
        self.age = age
        self.thesis = thesis
    }

    function display() {
        print("Grad Student: " + self.name + " (" + str(self.age) + "), Thesis: " + self.thesis)
    }
}

let student1 = Student("Santhiya", 21)
student1.display()

let student2 = GraduateStudent("Alex", 24, "Compiler Design")
student2.display()

HAKAI END

