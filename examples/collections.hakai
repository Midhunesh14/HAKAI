// Collections: Arrays, Maps, and Tuples
let numbers = [10, 20, 30, 40]
print("First element: " + str(numbers[0]))
numbers[1] = 99
print("Updated second element: " + str(numbers[1]))
print("Array length: " + str(len(numbers)))

