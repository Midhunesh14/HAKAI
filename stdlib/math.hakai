// HAKAI Math Standard Library

function min(a, b) {
    if a < b {
        return a
    }
    return b
}

function max(a, b) {
    if a > b {
        return a
    }
    return b
}

function clamp(val, min_val, max_val) {
    if val < min_val {
        return min_val
    }
    if val > max_val {
        return max_val
    }
    return val
}

function is_even(n) {
    return n % 2 == 0
}

function is_odd(n) {
    return n % 2 != 0
}

