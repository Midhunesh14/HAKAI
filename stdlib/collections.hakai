// HAKAI Collections Standard Library

function find(arr, item) {
    let i = 0
    while i < len(arr) {
        if arr[i] == item {
            return i
        }
        i = i + 1
    }
    return -1
}

function contains(arr, item) {
    return find(arr, item) != -1
}

function reverse(arr) {
    let result = []
    let i = len(arr) - 1
    while i >= 0 {
        result = result + [arr[i]]
        i = i - 1
    }
    return result
}

